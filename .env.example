# ==============================================================
# AR FLEETTRACK ENVIRONMENT CONFIGURATION
# ==============================================================

# Database Connection (PostgreSQL on Neon, Supabase, Railway or SQLite locally)
DATABASE_URL="postgresql://postgres:password@ep-sample-123.us-east-2.aws.neon.tech/fleettrack?sslmode=require"

# Webhook Authentication Secret
# Configure this secret in Vercel Environment Variables and provide it in your webhook URL:
# https://your-domain.vercel.app/api/webhooks/email?token=sk_live_fleettrack_secret_key_9921
# or in the HTTP header: x-webhook-secret: sk_live_fleettrack_secret_key_9921
EMAIL_WEBHOOK_SECRET="sk_live_fleettrack_secret_key_9921"

# Node Environment
NODE_ENV="production"
